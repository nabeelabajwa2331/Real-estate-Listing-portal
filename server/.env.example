# Copy this file to .env and fill in the values.

PORT=5000
# Set to "production" when deployed.
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/real-estate

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# Address of the React app. In production set this to your deployed URL. It is
# used for CORS and for links in emails. When the API serves the built client
# (NODE_ENV=production), this should match the site's public URL.
CLIENT_URL=http://localhost:5173

# Cookie behaviour. Use "none" with HTTPS-only deployments behind a proxy, or
# keep "lax" for same-site deployments.
COOKIE_SAMESITE=lax

# Email. Leave SMTP_HOST empty in development and the server captures messages
# in an Ethereal test inbox (a preview link is printed). Set EMAIL_TRANSPORT=console
# to print in the terminal. To use Mailtrap's sandbox instead, set
# SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525 and your Mailtrap user/pass.
# In production, set SMTP_* to your provider so users receive email themselves.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Real Estate <no-reply@example.com>"
EMAIL_TRANSPORT=ethereal

# How long an email-verification link stays valid.
VERIFY_EXPIRES_HOURS=24

# DNS timeout (ms) for the signup MX-record check.
MX_LOOKUP_TIMEOUT_MS=4000

# Image uploads. Fill in all three to store images on Cloudinary; leave empty
# to save under server/uploads and serve from /uploads (fine for dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Address lookup (Nominatim) sends this User-Agent, as their policy requires.
GEOCODE_USER_AGENT=real-estate-app/1.0 (contact@example.com)

# Rate limits (requests per window per IP)
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=20
GEOCODE_RATE_LIMIT=20
MESSAGE_RATE_LIMIT=60

# Used by: npm run create-admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=03000000000
ADMIN_PASSWORD=change-this-password
