# Map tiles.
#
# Leave VITE_MAPTILER_KEY empty to use the default OpenStreetMap raster tiles
# (no signup, fine for development). To use MapTiler's styled basemaps, create a
# free key at https://www.maptiler.com/ and set it below. VITE_MAP_STYLE can be
# any MapTiler style id, e.g. streets-v2, basic-v2, streets-v2-dark.
VITE_MAPTILER_KEY=
VITE_MAP_STYLE=streets-v2

# API host. Leave empty when the server serves this built client (single-service
# deployment) so requests go to the same origin. Set it to the API's public URL
# when the client is hosted separately, for example:
#   VITE_API_URL=https://your-api.example.com
VITE_API_URL=

# Optional Google sign-in fallback. Normally the client fetches the public
# client ID from the API at runtime, so set GOOGLE_CLIENT_ID on the server and
# leave this empty. Set it only for static hosting where
# /api/auth/google/config is unavailable; it must match the server's
# GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
